# xash_link_relocatable.cmake - run with cmake -P, see XashStaticLib.cmake
#
# Inputs: NAME MODE(FILE|OBJECTS) EXPORTS_FILE OBJLIST OUTDIR UNSTRIPPED FINAL CC CFLAGS LD OBJCOPY READELF

file(STRINGS "${OBJLIST}" objects)
list(FILTER objects EXCLUDE REGEX "^[ \t]*$")

set(helper_c "${OUTDIR}/link_helper.c")
set(helper_o "${OUTDIR}/link_helper.o")

# 1. collect the export names
set(exports "")
if(MODE STREQUAL "FILE")
	file(STRINGS "${EXPORTS_FILE}" exports)
	list(FILTER exports EXCLUDE REGEX "^[ \t]*(#.*)?$")
else()
	# partial link without the helper first, then list the visible functions it defines
	set(pre "${OUTDIR}/${NAME}.pre.o")
	execute_process(COMMAND "${LD}" -r -o "${pre}" ${objects} RESULT_VARIABLE rc ERROR_VARIABLE err)
	if(NOT rc EQUAL 0)
		message(FATAL_ERROR "ld -r failed for ${NAME}:\n${err}")
	endif()
	execute_process(COMMAND "${READELF}" -sW "${pre}" OUTPUT_VARIABLE symtab RESULT_VARIABLE rc)
	if(NOT rc EQUAL 0)
		message(FATAL_ERROR "readelf failed for ${NAME}")
	endif()
	string(REPLACE "\n" ";" lines "${symtab}")
	foreach(line IN LISTS lines)
		# Num: Value Size Type Bind Vis Ndx Name
		if(line MATCHES "^ *[0-9]+: +[0-9a-fA-F]+ +[0-9]+ +FUNC +GLOBAL +DEFAULT +[0-9]+ +([A-Za-z_][A-Za-z0-9_]*)$")
			set(sym "${CMAKE_MATCH_1}")
			# skip C++ mangled names: the engine only looks up C names
			if(NOT sym MATCHES "^_Z")
				list(APPEND exports "${sym}")
			endif()
		endif()
	endforeach()
	list(REMOVE_DUPLICATES exports)
	list(SORT exports)
endif()

list(LENGTH exports nexports)
if(nexports EQUAL 0)
	message(FATAL_ERROR "${NAME}: no exports found")
endif()

# 2. generate and compile link_helper.c
set(src "/* generated by xash_link_relocatable.cmake, do not edit */\n")
foreach(e IN LISTS exports)
	string(APPEND src "extern void ${e}(void);\n")
endforeach()
string(APPEND src "struct {const char *name;void *func;} lib_${NAME}_exports[] = {\n")
foreach(e IN LISTS exports)
	string(APPEND src "{ \"${e}\", (void*)&${e} },\n")
endforeach()
string(APPEND src "{0,0}\n};\n")
file(WRITE "${helper_c}" "${src}")
file(WRITE "${OUTDIR}/exports.txt" "")
foreach(e IN LISTS exports)
	file(APPEND "${OUTDIR}/exports.txt" "${e}\n")
endforeach()

separate_arguments(cflags UNIX_COMMAND "${CFLAGS}")
execute_process(COMMAND "${CC}" ${cflags} -fno-builtin -w -c "${helper_c}" -o "${helper_o}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
	message(FATAL_ERROR "compiling link_helper.c for ${NAME} failed:\n${err}")
endif()

# 3. partial link everything, then hide all symbols except the export table
execute_process(COMMAND "${LD}" -r -o "${UNSTRIPPED}" ${objects} "${helper_o}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
	message(FATAL_ERROR "ld -r failed for ${NAME}:\n${err}")
endif()

# -R .group: drop the COMDAT groups (C++ inline functions, vtables, templates) now that ld -r has
# merged them inside this library. Otherwise the final link would merge e.g. the client's and the
# server's CHandGrenade vtable into one and the references from the discarded copy would break,
# because objcopy -G made those symbols local.
execute_process(COMMAND "${OBJCOPY}" -R .group -G "lib_${NAME}_exports" "${UNSTRIPPED}" "${FINAL}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
	message(FATAL_ERROR "objcopy failed for ${NAME}:\n${err}")
endif()

message(STATUS "${NAME}: ${nexports} exports")
