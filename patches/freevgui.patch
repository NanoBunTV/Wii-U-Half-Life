index a4803ed..9a13f64 100644
--- a/inputstream.cpp
+++ b/inputstream.cpp
@@ -5,6 +5,22 @@
 
 using namespace vgui;
 
+// VGUI data files are little-endian, convert multi-byte values to host order
+template<typename T> static T LittleToHost( T v )
+{
+#if defined( __BYTE_ORDER__ ) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+	unsigned char *p = (unsigned char *)&v;
+
+	for( size_t i = 0; i < sizeof( T ) / 2; i++ )
+	{
+		unsigned char tmp = p[i];
+		p[i] = p[sizeof( T ) - 1 - i];
+		p[sizeof( T ) - 1 - i] = tmp;
+	}
+#endif
+	return v;
+}
+
