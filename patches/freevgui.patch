 	stream( is )
 {
@@ -96,7 +112,7 @@ unsigned short DataInputStream::readUShort( bool &success )
 		stream->readUChar( (unsigned char *)( &ret ), sizeof( ret ), success );
 	else success = false;
 
-	return ret;
+	return LittleToHost( ret );
 }
 
