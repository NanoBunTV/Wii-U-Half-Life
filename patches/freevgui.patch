diff --git a/fileimage.cpp b/fileimage.cpp
index cb562fe..12660f7 100644
--- a/fileimage.cpp
+++ b/fileimage.cpp
@@ -4,6 +4,24 @@
 #include "fileimage.h"
 #include "vgui_internal.h"
 
+// TGA header fields are little-endian on disk, convert them to/from host order
+static uint16_t TGA_Short( uint16_t v )
+{
+	const uint8_t *b = (const uint8_t *)&v;
+
+	return (uint16_t)( b[0] | ( b[1] << 8 ));
+}
+
+static void TGA_SwapHeader( TGAFileHeader *hdr )
+{
+	hdr->m_CMapStart = TGA_Short( hdr->m_CMapStart );
+	hdr->m_CMapLength = TGA_Short( hdr->m_CMapLength );
+	hdr->m_XOffset = TGA_Short( hdr->m_XOffset );
+	hdr->m_YOffset = TGA_Short( hdr->m_YOffset );
+	hdr->m_Width = TGA_Short( hdr->m_Width );
+	hdr->m_Height = TGA_Short( hdr->m_Height );
+}
+
 bool Load32BitTGA( FileImageStream *fp, FileImage *image )
 {
 	TGAFileHeader hdr;
@@ -11,6 +29,7 @@ bool Load32BitTGA( FileImageStream *fp, FileImage *image )
 	image->Term();
 
 	fp->Read( &hdr, sizeof( hdr ));
+	TGA_SwapHeader( &hdr );
 	if( fp->ErrorStatus() || hdr.m_PixelDepth != 32 || hdr.m_ImageType != 10 )
 		return false;
 
@@ -96,6 +115,7 @@ void Save32BitTGA( FileHandle_t fp, FileImage *image )
 	hdr.m_ImageType = 10;
 	hdr.m_Width = image->m_Width;
 	hdr.m_Height = image->m_Height;
+	TGA_SwapHeader( &hdr ); // the conversion is its own inverse
 
 	fwrite( &hdr, 1, sizeof( hdr ), (FILE *)fp );
 
