@@ -17,6 +17,37 @@
 #include "neon_mathfun.h"
 #endif
 
+#if XASH_WIIU
+// The Wii U's CPU (PowerPC 750) has no fast sin/cos/acos: newlib's take well over 100 cycles each, and
+// bone setup calls them about 16 times per bone and animation layer. These are close enough for
+// animation (sin/cos within ~1e-7 for the angles bones use)
+static inline void WiiU_SinCos( float x, float *s, float *c )
+{
+	// reduce to r in [-pi/4, pi/4] and a quadrant, pi/2 split in two parts for precision
+	float fq = x * 0.63661977f;
+	int q = (int)( fq >= 0.0f ? fq + 0.5f : fq - 0.5f );
+	float r = ( x - (float)q * 1.57079637f ) + (float)q * 4.37113883e-8f;
+	float r2 = r * r;
+	float sr = r + r * r2 * ( -1.66666667e-1f + r2 * ( 8.33333333e-3f + r2 * ( -1.98412698e-4f + r2 * 2.75573192e-6f )));
+	float cr = 1.0f + r2 * ( -0.5f + r2 * ( 4.16666667e-2f + r2 * ( -1.38888889e-3f + r2 * 2.48015873e-5f )));
+
+	switch( q & 3 )
+	{
+	case 0: *s = sr; *c = cr; break;
+	case 1: *s = cr; *c = -sr; break;
+	case 2: *s = -sr; *c = -cr; break;
+	default: *s = -cr; *c = sr; break;
+	}
+}
+
+static inline float WiiU_Sin( float x )
+{
+	float s, c;
+	WiiU_SinCos( x, &s, &c );
+	return s;
+}
+#endif
+
