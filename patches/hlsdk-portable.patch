+		inv = inv * ( 1.5f - 0.5f * len2 * inv * inv );
+
+		for( i = 0; i < 4; i++ )
+			qt[i] *= inv;
+		return;
+	}
+#endif
+
 	if( ( 1.0f + cosom ) > 0.000001f )
 	{
 		if( ( 1.0f - cosom ) > 0.000001f )
 		{
 			omega = acos( cosom );
+#if XASH_WIIU
