+#if XASH_WIIU
+	if( cosom > 0.95f )
+	{
+		// close quaternions (neighbouring animation frames): a normalised linear blend is within about
+		// 0.06 degrees of the spherical one here and needs no acos/sin. 1/sqrt by two Newton steps from 1,
+		// the length is at least 0.98 (the PowerPC 750 has no sqrt instruction)
+		float len2, inv = 1.0f;
+
+		for( i = 0; i < 4; i++ )
+			qt[i] = ( 1.0f - t ) * p[i] + t * q[i];
