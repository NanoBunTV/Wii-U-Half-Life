 static inline void SinCos( float radians, float *sine, float *cosine )
 {
+#if XASH_WIIU
+	// newlib's sin/cos (double precision here) take well over 100 cycles each on the Wii U's CPU, and
+	// bone setup, view and movement math call them a lot. Within ~1e-6 for |radians| < 20: reduce to
+	// [-pi/4, pi/4] and a quadrant (pi/2 split in two parts for precision), then short polynomials
+	float fq = radians * 0.63661977f;
+	int q = (int)( fq >= 0.0f ? fq + 0.5f : fq - 0.5f );
+	float r = ( radians - (float)q * 1.57079637f ) + (float)q * 4.37113883e-8f;
+	float r2 = r * r;
+	float s = r + r * r2 * ( -1.66666667e-1f + r2 * ( 8.33333333e-3f + r2 * ( -1.98412698e-4f + r2 * 2.75573192e-6f )));
+	float c = 1.0f + r2 * ( -0.5f + r2 * ( 4.16666667e-2f + r2 * ( -1.38888889e-3f + r2 * 2.48015873e-5f )));
+
+	switch( q & 3 )
+	{
+	case 0: *sine = s; *cosine = c; break;
+	case 1: *sine = c; *cosine = -s; break;
+	case 2: *sine = -s; *cosine = -c; break;
+	default: *sine = -c; *cosine = s; break;
+	}
+#else
 	*sine = sin( radians );
 	*cosine = cos( radians );
+#endif
 }
 
