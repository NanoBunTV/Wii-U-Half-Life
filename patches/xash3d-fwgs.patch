+		{ K_JOY2,          "+attack" },             // ZR
+		{ K_JOY1,          "+attack2" },            // ZL
+		{ K_R1_BUTTON,     "invnext" },             // R
+		{ K_L1_BUTTON,     "invprev" },             // L
+		{ K_A_BUTTON,      "+jump" },
+		{ K_B_BUTTON,      "+duck" },
+		{ K_X_BUTTON,      "+reload" },
+		{ K_Y_BUTTON,      "+use" },
+		{ K_DPAD_UP,       "impulse 100" },         // flashlight
+		{ K_DPAD_DOWN,     "lastinv" },
+		{ K_DPAD_LEFT,     "save quick" },
+		{ K_DPAD_RIGHT,    "load quick" },
+		{ K_LSTICK,        "+speed" },              // walk while held
+		{ K_RSTICK,        "joy_centerview" },
+		{ K_START_BUTTON,  "cancelselect" },        // +: pause menu
+		{ K_BACK_BUTTON,   "+gyro_recenter" },      // -: level the view, gyro paused while held
+		{ K_L2_BUTTON,     "" },                    // unused by SDL2, triggers are K_JOY1/K_JOY2
+		{ K_R2_BUTTON,     "" },
