 	// stub
 }
 
+#if XASH_WIIU
+static int Launcher_Run( void )
+{
+	return Host_Main( szArgc, szArgv, XASH_GAMEDIR, 0, Sys_ChangeGame );
+}
+#endif
+
 int main( int argc, char **argv )
 {
 #if XASH_PSVITA
 	// inject -dev -console into args if required
 	szArgc = PSVita_GetArgv( argc, argv, &szArgv );
+#elif XASH_WIIU
+	// mounts the SD card and adds arguments from the SD card's command line file
+	szArgc = WiiU_GetArgv( argc, argv, &szArgv );
+	// the RPX main thread has a 64 KB stack, far too small for the engine
+	return WiiU_RunOnBigStack( Launcher_Run );
 #elif XASH_IOS
 	IOS_LaunchDialog();
 	szArgc = IOS_GetArgs( &szArgv );
