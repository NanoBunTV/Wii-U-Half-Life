+/*
+================
+Host_WiiUUpgradeConfig
+
+config.cfg saves every archived cvar, defaults included, so a default changed in a later version never
+reaches an existing install. Each step here applies the Wii U defaults of one version once; add a step
+whenever a Wii U default changes. Runs after config.cfg, before the command line
+================
+*/
+static void Host_WiiUUpgradeConfig( void )
+{
+	static const char *const steps[] =
+	{
+		// 1: weapons switch directly with L/R, HUD text sized for 720p
+		"hud_fastswitch 1\nhud_fontscale 2\n",
+		// 2: console font (also notify lines, FPS counter, centre prints) readable on the GamePad
+		"con_fontscale 2\n",
+	};
+	int version = (int)wiiu_config_version.value;
+
+	if( version < 0 || version >= (int)ARRAYSIZE( steps ))
+		return;
+
+	for( ; version < (int)ARRAYSIZE( steps ); version++ )
+		Cbuf_AddText( steps[version] );
+
+	Cbuf_AddTextf( "wiiu_config_version %d\n", version );
+	Cbuf_Execute();
+	Con_Printf( "Applied Wii U default settings (config version %d)\n", version );
+}
+#endif
