+each sample is only returned once, so it would starve the gyro (SDL reads first) and steal button
+presses from SDL (which uses the samples' trigger/release bits). Instead the link wraps VPADRead
+(-Wl,--wrap=VPADRead) and the gyro is collected from SDL's own reads (one sample per frame).
+=============
+*/
+int32_t __real_VPADRead( VPADChan chan, VPADStatus *buffers, uint32_t count, VPADReadError *outError );
+
+static vec3_t wiiu_gyro_sum;
+static int wiiu_gyro_samples;
+
+int32_t __wrap_VPADRead( VPADChan chan, VPADStatus *buffers, uint32_t count, VPADReadError *outError )
+{
+	int32_t read = __real_VPADRead( chan, buffers, count, outError );
+
+	if( chan == VPAD_CHAN_0 && read > 0 && ( !outError || *outError == VPAD_READ_SUCCESS ))
+	{
+		for( int32_t i = 0; i < read; i++ )
+		{
+			wiiu_gyro_sum[0] += buffers[i].gyro.x;
+			wiiu_gyro_sum[1] += buffers[i].gyro.y;
+			wiiu_gyro_sum[2] += buffers[i].gyro.z;
+			wiiu_gyro_samples++;
+		}
+	}
+
+	return read;
+}
+
+/*
+=============
+SDLash_WiiUGyroFrame
+
+Feed the average GamePad rotation rate since the last frame to the gyro code. Called every frame,
+after SDL has polled the controllers.
+=============
+*/
+void SDLash_WiiUGyroFrame( void )
+{
+	vec3_t sample;
+	float scale;
+
+	if( !wiiu_gyro_samples )
+		return;
+
+	// VPAD reports revolutions per second
+	scale = ( 2.0f * M_PI ) / wiiu_gyro_samples;
+	VectorScale( wiiu_gyro_sum, scale, sample );
+	VectorClear( wiiu_gyro_sum );
+	wiiu_gyro_samples = 0;
+
+	if( !SDLash_IsWiiUGamePad( g_current_gamepad ))
+		return;
+
+	SDLash_GyroSample( sample );
+}
